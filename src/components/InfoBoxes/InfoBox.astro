---
interface Props {
    icon: string;
    title: string;
    content: string;
}

const { icon, title, content } = Astro.props;

const html = "<strong>" + title + ":</strong> " + content;
---

<div class="fun-fact">
    <img src={icon} class="icon" />
    <div class="info-text-container">
        <p set:html={html} />
    </div>
</div>

<style>
    .fun-fact {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-top: 2rem;
        margin-bottom: 2rem;
    }
    .icon {
        width: calc(20% - 0.5rem);
    }
    .info-text-container {
        width: calc(80% - 0.5rem);
    }
    .info-text-container p {
        margin: 0;
    }
</style>
