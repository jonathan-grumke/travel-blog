---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="de">
    <head>
        <BaseHead
            title=`Kontakt | ${SITE_TITLE}`
            `
            description={SITE_DESCRIPTION}
        />
    </head>
    <body>
        <Header />
        <main>
            <h1 class="space-after">Kontakt</h1>
            <div class="contact-row space-after">
                <div class="grid-image">
                    <img alt="" src="/icons/instagram.png" />
                </div>
                <div class="grid-text">
                    <p>
                        Du willst noch mehr von unserer Reise sehen? Dann folge
                        uns auf <strong>Instagram</strong>!
                    </p>
                </div>
                <div class="grid-button">
                    <a
                        href="https://www.instagram.com/_me_monique/"
                        target="_blank"
                    >
                        <button class="button-primary">Folge uns</button>
                    </a>
                </div>
            </div>
            <div class="contact-row space-after">
                <div class="grid-image">
                    <img alt="" src="/icons/youtube.png" />
                </div>
                <div class="grid-text">
                    <p>
                        Hin und wieder laden wir Videos von unserer Reise auf
                        <strong>YouTube</strong> hoch. Schau sie dir gerne an!
                    </p>
                </div>
                <div class="grid-button">
                    <a
                        href="https://www.youtube.com/@jonathangrumke"
                        target="_blank"
                    >
                        <button class="button-primary">Zum Kanal</button>
                    </a>
                </div>
            </div>
            <div class="contact-row space-after">
                <div class="grid-image">
                    <img alt="" src="/icons/pinterest.png" />
                </div>
                <div class="grid-text">
                    <p>
                        Du suchst noch mehr Inspiration zum Reisen? Folge uns
                        auf <strong>Pinterest</strong>!
                    </p>
                </div>
                <div class="grid-button">
                    <a href="https://www.pinterest.com" target="_blank">
                        <button class="button-primary">Zu Pinterest</button>
                    </a>
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>

<style>
    .contact-row {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: center;
    }
    .grid-image {
        width: 4rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .grid-text {
        width: calc(100% - 22rem);
    }
    .grid-button {
        width: 14rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .grid-button a {
        display: block;
    }
    @media (max-width: 720px) {
        .contact-row {
            flex-direction: column;
        }
        .grid-text {
            width: 100%;
            text-align: center;
        }
    }
</style>
