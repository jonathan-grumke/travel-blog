---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import GuideTiles from "../../components/GuideTiles.astro";

const posts = (await getCollection("travelGuide")).sort(
    (a, b) => b.data.updatedDate.valueOf() - a.data.updatedDate.valueOf()
);
---

<!doctype html>
<html lang="de">
    <head>
        <BaseHead
            title=`Reisetipps | ${SITE_TITLE}`
            description={SITE_DESCRIPTION}
        />
        <style>
            main {
                width: 820px;
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <h1>Du suchst Inspiration für deine nächste Reise?</h1>
            <p>
                Hier erscheinen bald unsere Beiträge mit Erfahrungsberichten,
                Empfehlungen und Inspirationen für deinen nächsten Urlaub!
            </p>
            <GuideTiles numberOfPosts={100} />
        </main>
        <Footer />
    </body>
</html>
